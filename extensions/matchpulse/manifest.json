{
  "manifest_version": 2,
  "name": "MatchPulse — DevGitBrowser",
  "short_name": "MatchPulse",
  "version": "0.6.0",
  "description": "Suivi sportif en lecture seule : Betclic, Winamax, Unibet. Probabilité estimée des tickets avant validation, détection des tickets, alertes gratuites ESPN (buts, pénaltys, cartons, fautes, corners) et notifications Windows.",
  "author": "CodexHempreur INC",
  "permissions": [
    "https://site.api.espn.com/*",
    "https://v3.football.api-sports.io/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://betclic.fr/*",
        "*://*.betclic.fr/*",
        "*://winamax.fr/*",
        "*://*.winamax.fr/*",
        "*://unibet.fr/*",
        "*://*.unibet.fr/*",
        "*://unibet.be/*",
        "*://*.unibet.be/*",
        "*://unibetsports.be/*",
        "*://*.unibetsports.be/*"
      ],
      "js": [
        "core.js",
        "dom-reader.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
