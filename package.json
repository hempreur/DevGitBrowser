{
  "name": "devgitbrowser",
  "productName": "DevGitBrowser",
  "version": "1.10.0",
  "devgitStats": {
    "url": "https://devgit-15-235-120-182.sslip.io:8443",
    "pin": "c7358541ccc940ef89a1f27c1bcfc87355f1b3a9ebe00ee986f7d63d45476b0f"
  },
  "private": true,
  "description": "DevGitBrowser : navigateur Chromium pour Windows avec DevGitShield (anti-pub YouTube/Twitch), historique, favoris, onglets détachables, Picture-in-Picture, mises à jour automatiques, MatchPulse, IE11 et analyse réseau",
  "author": {
    "name": "CodexHempreur",
    "organization": "CodexHempreur INC"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:win:dir": "electron-builder --win dir --x64 --publish never && node scripts/write-app-update.js",
    "build:win:installer": "electron-builder --win nsis --x64 --publish never --prepackaged dist/win-unpacked"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "inc.codexhempreur.devgitbrowser",
    "productName": "DevGitBrowser",
    "copyright": "Copyright © 2026 CodexHempreur INC",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "ui/**/*",
      "assets/**/*",
      "legacy/**/*",
      "network/**/*",
      "extensions/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "DevGitBrowser",
      "artifactName": "DevGitBrowser-Setup-${version}.${ext}",
      "icon": "assets/icon.ico",
      "legalTrademarks": "CodexHempreur INC",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevGitBrowser",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "differentialPackage": true
    },
    "asarUnpack": [
      "legacy/**/*",
      "extensions/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hempreur",
        "repo": "DevGitBrowser",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "extraResources": [
      {
        "from": "vendor/tor",
        "to": "tor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/video",
        "to": "video",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "electronVersion": "45.2.1",
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hempreur/DevGitBrowser.git"
  },
  "homepage": "https://github.com/hempreur/DevGitBrowser"
}
